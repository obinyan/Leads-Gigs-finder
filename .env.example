# Copy this file to .env and fill in your own keys. Never commit .env.

# --- Claude API (scoring + drafting) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model used for scoring and drafting. Haiku is cheap/fast for scoring;
# you can use a stronger model for drafting via CLAUDE_DRAFT_MODEL below.
CLAUDE_SCORE_MODEL=claude-haiku-4-5-20251001
CLAUDE_DRAFT_MODEL=claude-sonnet-5

# --- Freelancer.com API ---
# Register an app at https://developers.freelancer.com and get an OAuth token
# (self-auth flow works for a single-user tool like this one).
FREELANCER_OAUTH_TOKEN=

# --- Google Custom Search JSON API ---
# 1. Create an API key: https://console.developers.google.com
# 2. Create a Programmable Search Engine (set it to search the whole web):
#    https://programmablesearchengine.google.com
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Server (local dev only — ignored on Vercel) ---
PORT=3000

# --- Optional: how often to auto-poll locally, in cron syntax ---
# Only used by `npm start` (local-server.js). On Vercel, scheduling is done
# by the GitHub Actions workflow in .github/workflows/poll.yml instead.
POLL_CRON=0 */3 * * *

# --- Upstash Redis (only needed once deployed to Vercel) ---
# Vercel KV was discontinued; the current path is installing "Upstash Redis"
# from the Vercel Marketplace and connecting it to this project — Vercel then
# injects these two automatically, you don't set them by hand. Left blank,
# the app falls back to the local JSON file in data/leads.json, which is what
# happens automatically in local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
